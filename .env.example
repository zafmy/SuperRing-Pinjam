PORT=3001
DATA_DIR=.data
# Agent provider: CommandCode, using an OpenAI model.
# Set a real key on the backend to enable host-triggered agent steps.
CMD_API_KEY=
AI_BASE_URL=https://api.commandcode.ai/provider/v1
AI_MODEL=gpt-5.5
# Store the real CommandCode key only in local .env or Dokploy Environment.
# Never put provider credentials in VITE_* variables or commit them.
